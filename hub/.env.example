# Copy to hub/.env (gitignored). Frigate substitutes {FRIGATE_*} in its config.
# Use a separate, low-rights camera account for RTSP, not the camera's admin.
FRIGATE_RTSP_USER=
FRIGATE_RTSP_PASSWORD=
# The "frigate" user you added with mosquitto_passwd.
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=
# Login for Frigate's own RTSP restream (port 8554).
FRIGATE_RESTREAM_USER=
FRIGATE_RESTREAM_PASSWORD=
